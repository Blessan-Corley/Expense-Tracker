# Single environment example for the whole repo.
# Copy values as needed into:
# - apps/backend/.env
# - apps/frontend/.env

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/expensetracker"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/expensetracker"

# Auth
JWT_SECRET="replace-with-strong-random-secret"
JWT_EXPIRES_IN="30d"

# Server
PORT=5000
NODE_ENV=development

# CORS (comma-separated)
CORS_ORIGIN="http://localhost:3000,http://localhost:4173"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Recurring jobs
AUTO_PROCESS_RECURRING=false
PROCESS_RECURRING_INTERVAL_MINUTES=60

# Docker Compose local Postgres
POSTGRES_DB=expensetracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD="replace-with-strong-db-password"

# Frontend API base URL
VITE_API_URL="http://localhost:5000/api"
